# Copy to .env and customise
APP_NAME=NEXTSHIELD
DEBUG=true
FRONTEND_ORIGIN=http://localhost:3000
PHISHING_MODEL_PATH=models/phishing_classifier.pkl
ANOMALY_MODEL_PATH=models/anomaly_detector.pkl
ANOMALY_IFOREST_PATH=models/anomaly_iforest.joblib
ANOMALY_XGBOOST_PATH=models/anomaly_xgboost.joblib
ANOMALY_FEATURE_SCALER_PATH=models/anomaly_scaler.joblib
